plugin hlMatchCard (
    name: HL Match Card
    staticId: COM.HARVESTLINK.MATCHCARD
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            <article class="hl-match{if ?STATUS/} hl-match-#STATUS!ATTR#{endif/}">{if ?RANK/}<span class="hl-match-rank" aria-label="Rank #RANK!ATTR#">#RANK#</span>{endif/}<div><h3 class="hl-match-name">#FARMER#</h3><p class="hl-match-meta"><span>#LOCATION#</span>{if ?DISTANCE/}<span class="hl-num">#DISTANCE#</span>{endif/}{if ?HARVEST/}<span>Harvest #HARVEST#</span>{endif/}</p></div><div class="hl-match-qty"><strong>#QTY#</strong><span>#QTY_LABEL#</span></div><div class="hl-match-tags"><span class="hl-grade hl-grade-{case GRADE/}{when A/}a{when B/}b{otherwise/}c{endcase/}" title="Grade #GRADE!ATTR#"><b aria-hidden="true">#GRADE#</b><span>{case GRADE/}{when A/}Grade A · Premium{when B/}Grade B · Market{when C/}Grade C · Processing{otherwise/}Grade #GRADE#{endcase/}</span></span>{if ?STATUS/}<span class="hl-badge hl-badge-#STATUS!ATTR#">{case STATUS/}{when matched/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{when confirmed/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{when delivered/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-7"></path></svg>{when transit/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.75 4h7.5v6.5h-7.5zM9.25 6.5h3l2 2.25v1.75h-5M4.5 12.5a1.25 1.25 0 1 0 0-.01M11.5 12.5a1.25 1.25 0 1 0 0-.01"></path></svg>{when scheduled/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.25 3.5h11.5v10.25H2.25zM2.25 6.5h11.5M5 2v3M11 2v3"></path></svg>{when pending/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>{when awaiting/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>{otherwise/}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8h5.5"></path></svg>{endcase/}{if ?STATUS_TEXT/}#STATUS_TEXT#{else/}{case STATUS/}{when matched/}Matched{when confirmed/}Confirmed{when delivered/}Delivered{when transit/}In transit{when scheduled/}Pickup scheduled{when pending/}Pending{when awaiting/}Awaiting farmer{when unmatched/}Unmatched{when cancelled/}Cancelled{when draft/}Draft{otherwise/}#STATUS#{endcase/}{endif/}</span>{endif/}</div><details{if OPEN/} open{endif/}><summary>#REASONS_TITLE#</summary><ul class="hl-reasons">{if ?REASON1_LABEL/}<li class="hl-{case REASON1_STATE/}{when warn/}warn{when no/}no{otherwise/}ok{endcase/}">{case REASON1_STATE/}{when warn/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>{when no/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8h5.5"></path></svg>{otherwise/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{endcase/}<div><b>#REASON1_LABEL#</b><span>#REASON1_DETAIL#</span></div></li>{endif/}{if ?REASON2_LABEL/}<li class="hl-{case REASON2_STATE/}{when warn/}warn{when no/}no{otherwise/}ok{endcase/}">{case REASON2_STATE/}{when warn/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>{when no/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8h5.5"></path></svg>{otherwise/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{endcase/}<div><b>#REASON2_LABEL#</b><span>#REASON2_DETAIL#</span></div></li>{endif/}{if ?REASON3_LABEL/}<li class="hl-{case REASON3_STATE/}{when warn/}warn{when no/}no{otherwise/}ok{endcase/}">{case REASON3_STATE/}{when warn/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>{when no/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8h5.5"></path></svg>{otherwise/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{endcase/}<div><b>#REASON3_LABEL#</b><span>#REASON3_DETAIL#</span></div></li>{endif/}{if ?REASON4_LABEL/}<li class="hl-{case REASON4_STATE/}{when warn/}warn{when no/}no{otherwise/}ok{endcase/}">{case REASON4_STATE/}{when warn/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>{when no/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8h5.5"></path></svg>{otherwise/}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{endcase/}<div><b>#REASON4_LABEL#</b><span>#REASON4_DETAIL#</span></div></li>{endif/}</ul></details>{if ?ACTION_URL/}<div class="hlc-match-action"><a class="hl-btn hl-btn-secondary hl-btn-sm" href="#ACTION_URL!ATTR#"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-7"></path></svg>#ACTION_LABEL#</a>{if ?ACTION2_URL/}<a class="hl-btn hl-btn-ghost hl-btn-sm" href="#ACTION2_URL!ATTR#">#ACTION2_LABEL#</a>{endif/}{if ?ACTION_NOTE/}<span>#ACTION_NOTE#</span>{endif/}</div>{endif/}{if ?FOOTNOTE/}<p class="hlc-match-foot">#FOOTNOTE#</p>{endif/}</article>
            ```
        reportBody:
            ```html
            <div class="hlc-match-list #APEX$COMPONENT_CSS_CLASSES#">#APEX$ROWS#</div>
            ```
        reportRow:
            ```html
            <div #APEX$ROW_IDENTIFICATION#>#APEX$PARTIAL#</div>
            ```
        translateTemplates: false
    }
    component {
        standardAttributes: regionTemplateAttr
    }
    information {
        helpText: One farmer's supply against a demand with rank, grade, status and the four reasons (HarvestLink design system MatchCard).
    }
)

plugin hlFulfilmentBar (
    name: HL Fulfilment Bar
    staticId: COM.HARVESTLINK.FULFILMENTBAR
    templateComponent {
        availableAs: [
            partial
        ]
        partial:
            ```html
            <div class="hl-fill"><div class="hl-fill-head"><span class="hl-fill-total hl-num">#SOURCED#<small> of #TARGET# kg sourced</small></span><span class="hl-help">#CONFIRMED_PCT#% confirmed</span></div><div class="hl-fill-track" role="img" aria-label="#MATCHED# kg matched, #PENDING# pending, #UNMATCHED# unmatched of #TARGET#"><span class="hl-fill-seg hl-fill-matched" style="width:#MATCHED_WIDTH#%"></span><span class="hl-fill-seg hl-fill-pending" style="width:#PENDING_WIDTH#%"></span></div>{if LEGEND/}<ul class="hl-fill-legend"><li><span class="hl-key hl-key-matched"></span>#MATCHED_LABEL# <b class="hl-num">#MATCHED# kg</b></li><li><span class="hl-key hl-key-pending"></span>#PENDING_LABEL# <b class="hl-num">#PENDING# kg</b></li><li><span class="hl-key hl-key-unmatched"></span>#UNMATCHED_LABEL# <b class="hl-num">#UNMATCHED# kg</b></li></ul>{endif/}</div>
            ```
        translateTemplates: false
    }
    component {
        standardAttributes: regionTemplateAttr
    }
    information {
        helpText: Progress of a demand: matched, pending and unmatched kg (HarvestLink design system FulfilmentBar). Pass widths as numbers 0-100.
    }
)

page 40 (
    name: Grade Outlets
    alias: GRADE-OUTLETS
    title: Grade routing
    pageGroup: @dashboard
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
        cssClasses: hlc-app
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Canvas screen 6 (Grade routing). Grade cards and the allocation bars from HL_GRADE_ALLOCATION_V; lots, the allocate form and allocations call HL_ALLOC_PKG.
    }

    region header (
        name: Header
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_f hl_fulfil_v%rowtype;
                  l_a number; l_b number; l_c number; l_n number;
                begin
                  select * into l_f from hl_fulfil_v where demand_id = hl_demo.featured_demand_id;
                  select nvl(sum(case when grade = 'A' then kg end), 0), nvl(sum(case when grade = 'B' then kg end), 0), nvl(sum(case when grade = 'C' then kg end), 0)
                    into l_a, l_b, l_c from hl_grade_allocation_v where crop_id = l_f.crop_id;
                  return '<div class="hlc-root"><header class="hl-ph"><a class="hl-ph-back hl-link" href="' || apex_page.get_url(p_page => 32) || '" style="text-decoration:none"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 8H3M7 4L3 8l4 4"></path></svg>Back to matches</a>'
                    || '<span class="hl-overline">' || apex_escape.html(l_f.crop_name || ' · pickup ' || to_char(l_f.need_by_date - 1, 'Dy DD Mon')) || '</span>'
                    || '<div class="hl-ph-row"><div class="hl-stack" style="gap:4px"><h1>Grade routing</h1><p>'
                    || to_char(l_a + l_b + l_c, 'FM999G990') || ' kg of ' || apex_escape.html(lower(l_f.crop_name)) || ' in play: ' || to_char(l_a, 'FM999G990') || ' kg Grade A, '
                    || to_char(l_b, 'FM999G990') || ' kg Grade B and ' || to_char(l_c, 'FM999G990') || ' kg Grade C. Every grade gets an outlet.</p></div>'
                    || '<button type="button" class="hl-btn hl-btn-secondary hl-btn-sm" onclick="apex.confirm(''Reset every demand, harvest, match and route to the demo story?'', ''RESET_DEMO'');">Reset demo data</button>'
                    || '</div></header></div>';
                end;
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-full
        }
    )
    region grade-cards (
        name: Grade cards
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_crop number;
                  l_html varchar2(32767) := '<div class="hlc-root" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:24px">';
                begin
                  select crop_id into l_crop from hl_fulfil_v where demand_id = hl_demo.featured_demand_id;
                  for g in (select t.grade, t.cls, t.txt,
                                   (select nvl(sum(a.kg), 0) from hl_grade_allocation_v a where a.crop_id = l_crop and a.grade = t.grade) as kg
                              from (select 'A' grade, 'Premium' cls, 'Firm, even colour, no marks. Goes to the premium buyer who posted the demand.' txt from dual union all
                                    select 'B', 'Market', 'Small marks or uneven size. Sold at wholesale and local markets, and to schools.' from dual union all
                                    select 'C', 'Processing', 'Overripe or damaged. Goes to processors for paste and sauce instead of being thrown away.' from dual) t
                             order by t.grade) loop
                    l_html := l_html || '<section class="hlc-card" style="padding:24px;display:flex;flex-direction:column;gap:12px">'
                      || '<span class="hl-grade hl-grade-' || lower(g.grade) || '" title="Grade ' || g.grade || '" style="width:fit-content"><b aria-hidden="true">' || g.grade || '</b><span>Grade ' || g.grade || ' · ' || g.cls || '</span></span>'
                      || '<p style="margin:0;font:500 40px/44px var(--font-display);font-variant-numeric:tabular-nums">'
                      || to_char(g.kg, 'FM999G990')
                      || '<span style="font:400 15px/24px var(--font-sans);color:var(--ink-muted)"> kg</span></p>'
                      || '<p style="margin:0;font-size:13px;line-height:20px;color:var(--ink-muted)">' || g.txt || '</p></section>';
                  end loop;
                  return l_html || '</div>';
                end;
                ```
        }
        layout {
            sequence: 6
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-full
        }
    )
    region where-grades-go (
        name: Where each grade goes
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_crop number;
                  l_html varchar2(32767);
                  l_total number := 0; l_placed number := 0;
                begin
                  select crop_id into l_crop from hl_fulfil_v where demand_id = hl_demo.featured_demand_id;
                  select nvl(sum(kg), 0), nvl(sum(case when destination_type <> 'UNALLOCATED' then kg end), 0) into l_total, l_placed from hl_grade_allocation_v where crop_id = l_crop;
                  l_html := '<section class="hlc-root hlc-card" style="padding:24px;display:flex;flex-direction:column;gap:20px">'
                    || '<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><h2 style="margin:0;font:700 20px/28px var(--font-display)">Where each grade goes</h2>'
                    || '<span class="hl-prov hl-prov-live">Live data</span></div><div class="hl-alloc"><div class="hl-alloc-head"><h3 class="hl-match-name">Allocation by grade</h3>'
                    || '<span class="hl-help hl-num">' || to_char(l_placed, 'FM999G990') || ' of ' || to_char(l_total, 'FM999G990') || ' kg placed</span></div>';
                  for g in (select grade, sum(kg) total, sum(case when destination_type <> 'UNALLOCATED' then kg end) placed
                              from hl_grade_allocation_v where crop_id = l_crop group by grade order by grade) loop
                    l_html := l_html || '<div class="hl-alloc-row"><span class="hl-grade hl-grade-' || lower(g.grade) || '" title="Grade ' || g.grade || '"><b aria-hidden="true">' || g.grade
                      || '</b><span>Grade ' || g.grade || ' · ' || case g.grade when 'A' then 'Premium' when 'B' then 'Market' else 'Processing' end || '</span></span>'
                      || '<div class="hl-alloc-track" role="img" aria-label="Grade ' || g.grade || ' split">';
                    for o in (select destination, destination_type, kg from hl_grade_allocation_v where crop_id = l_crop and grade = g.grade
                               order by case destination_type when 'UNALLOCATED' then 1 else 0 end, kg desc) loop
                      l_html := l_html || '<span class="hl-alloc-seg ' || case when o.destination_type = 'UNALLOCATED' then 'hlc-alloc-open' else 'hl-alloc-' || lower(g.grade) end
                        || '" style="width:' || to_char(round(o.kg / g.total * 100, 2), 'FM990D00', 'NLS_NUMERIC_CHARACTERS=''.,''') || '%" title="'
                        || apex_escape.html(o.destination || ' · ' || to_char(o.kg, 'FM999G990') || ' kg') || '">' || apex_escape.html(o.destination) || '</span>';
                    end loop;
                    l_html := l_html || '</div><div class="hl-alloc-kg">' || to_char(nvl(g.placed, 0), 'FM999G990') || ' / ' || to_char(g.total, 'FM999G990') || '<span>kg placed</span></div></div>';
                  end loop;
                  return l_html || '<div class="hl-alloc-check hl-alloc-ok"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>No double-counting: every kilogram is assigned to at most one outlet.</div></div></section>';
                end;
                ```
        }
        layout {
            sequence: 7
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-full
        }
    )
    region lots (
        name: Lots still to place
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.HARVEST_ID as HARVEST_ID
                     , g.FARMER_NAME || ' · ' || g.LOCATION_NAME as OVERLINE
                     , to_char(g.AVAILABLE_KG, 'FM999G999G990') || ' kg of Grade ' || g.GRADE || ' ' || g.CROP_NAME as TITLE
                     , g.RECOMMENDED_CHANNEL
                       || case when g.SUGGESTED_BUYER is not null
                               then ' · suggested: ' || g.SUGGESTED_BUYER || ' ('
                                    || initcap(replace(g.SUGGESTED_BUYER_TYPE, '_', ' ')) || ', '
                                    || round(g.SUGGESTED_BUYER_KM) || ' km)' end as MISC
                     , case when b.BUYER_ID is not null
                            then '<div class="hl-actions">'
                                 || '<button type="button" class="t-Button t-Button--hot t-Button--small" '
                                 || 'onclick="apex.submit({request:''ALLOCATE'',set:{P40_HARVEST_ID:''' || g.HARVEST_ID
                                 || ''',P40_BUYER_ID:''' || b.BUYER_ID
                                 || ''',P40_KG:''' || to_char(g.AVAILABLE_KG, 'FM9999999990D99', 'NLS_NUMERIC_CHARACTERS=''.,''') || '''}});">'
                                 || 'Send ' || to_char(g.AVAILABLE_KG, 'FM999G999G990') || ' kg to '
                                 || apex_escape.html(g.SUGGESTED_BUYER) || '</button></div>' end as BODY_HTML
                from HL_GRADE_ROUTING_V g
                left join HL_BUYERS b on b.BUYER_NAME = g.SUGGESTED_BUYER
                order by g.CROP_NAME, g.GRADE, g.AVAILABLE_KG desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-left
        }
        accessibility {
            landmarkType: region
        }
        messages {
            whenNoDataFound: Every lot has an outlet. New lots appear here when farmers register harvests.
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            description: &BODY_HTML!RAW.
            miscellaneous: &MISC.
        }

        column BODY_HTML (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BODY_HTML
                dataType: varchar2
            }
        )

        column HARVEST_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: HARVEST_ID
                dataType: number
                primaryKey: true
            }
        )

        column MISC (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MISC
                dataType: varchar2
            }
        )

        column OVERLINE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )
    region allocate (
        name: Allocate a lot to an outlet
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-right hlc-rows-1
        }
        settings {
            outputAs: text
        }
    )
    region allocations (
        name: Sent to outlets
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.ALLOCATION_ID as ALLOCATION_ID
                     , a.FARMER_NAME || ' · Grade ' || a.GRADE || ' ' || a.CROP_NAME as OVERLINE
                     , to_char(a.ALLOC_KG, 'FM999G999G990') || ' kg to ' || a.OUTLET_NAME as TITLE
                     , initcap(replace(a.OUTLET_TYPE, '_', ' ')) || ' · by ' || a.CREATED_BY
                       || ' · ' || to_char(a.CREATED_AT, 'DD Mon HH24:MI') as MISC
                     , '<div class="hl-actions"><button type="button" class="t-Button t-Button--small" '
                       || 'onclick="apex.submit({request:''REMOVE'',set:{P40_ALLOCATION_ID:''' || a.ALLOCATION_ID || '''}});">'
                       || 'Remove</button></div>' as BODY_HTML
                from HL_ALLOCATIONS_V a
                order by a.CREATED_AT desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-left
        }
        accessibility {
            landmarkType: region
        }
        messages {
            whenNoDataFound: Nothing sent to outlets yet. Allocate a lot to send it to a school, market or processor.
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            description: &BODY_HTML!RAW.
            miscellaneous: &MISC.
        }

        column ALLOCATION_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ALLOCATION_ID
                dataType: number
                primaryKey: true
            }
        )

        column BODY_HTML (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BODY_HTML
                dataType: varchar2
            }
        )

        column MISC (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MISC
                dataType: varchar2
            }
        )

        column OVERLINE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )
    region demo-data (
        name: Demo data
        type: staticContent
        source {
            htmlCode:
                ```html
                <p class="hl-method">Restores the demo story (Kijani Fresh Grocers and the Kirinyaga farms) before a rehearsal. Confirmations already written to the agreement ledger stay there.</p>
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-right hlc-rows-1
        }
        settings {
            outputAs: html
        }
    )
    pageItem P40_HARVEST_ID (
        type: selectList
        label {
            label: Lot
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.FARMER_NAME || ' · Grade ' || g.GRADE || ' ' || g.CROP_NAME || ' · '
                       || to_char(g.AVAILABLE_KG, 'FM999G999G990') || ' kg left' as d
                     , g.HARVEST_ID as r
                from HL_GRADE_ROUTING_V g
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @allocate
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P40_BUYER_ID (
        type: selectList
        label {
            label: Outlet
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-buyers
        }
        layout {
            sequence: 20
            region: @allocate
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P40_KG (
        type: numberField
        label {
            label: Quantity (kg)
            alignment: right
        }
        layout {
            sequence: 30
            region: @allocate
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
    )
    pageItem P40_ALLOCATION_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @allocate
            slot: regionBody
        }
    )
    button allocate (
        buttonName: ALLOCATE
        label: Allocate
        layout {
            sequence: 10
            region: @allocate
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )
    button reset-demo (
        buttonName: RESET_DEMO
        label: Reset demo data
        layout {
            sequence: 10
            region: @demo-data
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Reset every demand, harvest, match and route to the demo story?
            style: danger
        }
    )
    process allocate (
        name: Allocate a lot to an outlet
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number;
                begin
                  if not hl_auth.is_ops then
                    raise_application_error(-20292, 'Only operations can allocate lots');
                  end if;
                  if :P40_HARVEST_ID is null or :P40_BUYER_ID is null or :P40_KG is null then
                    raise_application_error(-20293, 'Choose a lot and an outlet, and give the quantity');
                  end if;
                  l_id := hl_alloc_pkg.allocate(
                    p_harvest_id => to_number(:P40_HARVEST_ID),
                    p_buyer_id   => to_number(:P40_BUYER_ID),
                    p_kg         => to_number(:P40_KG));
                  :P40_HARVEST_ID := null;
                  :P40_BUYER_ID   := null;
                  :P40_KG         := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'ALLOCATE'
        }
    )
    process remove-allocation (
        name: Remove an allocation
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if not hl_auth.is_ops then
                  raise_application_error(-20292, 'Only operations can change allocations');
                end if;
                hl_alloc_pkg.remove(p_allocation_id => to_number(:P40_ALLOCATION_ID));
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'REMOVE'
        }
    )
    process reset-demo (
        name: Reset demo data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if not hl_auth.is_ops then
                  raise_application_error(-20292, 'Only operations can reset the demo data');
                end if;
                hl_demo.reset;
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'RESET_DEMO'
        }
    )
)

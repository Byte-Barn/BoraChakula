                ```html
                <div class="hlc-root"><section class="hlc-pad" style="padding:96px 40px"><div class="hlc-on-dark" style="max-width:1240px;margin:0 auto;position:relative;border-radius:28px;overflow:hidden;color:#fff;background:var(--forest-deep)"><img src="#APP_FILES#images/photo-farmer-sunhat.jpg" alt="A farmer in a sun hat holding a basket of vegetables" class="hlc-photo" style="position:absolute;inset:0;object-position:50% 30%"><div class="hlc-shade" style="position:absolute;inset:0"></div><div style="position:relative;padding:72px 56px;display:flex;flex-direction:column;gap:22px;max-width:560px"><h2 class="hlc-h2" style="margin:0;color:#fff">The next harvest is weeks away. <span class="hlc-lime">Sell it now.</span></h2><p style="margin:0;font-size:18px;line-height:28px;color:rgba(255,255,255,.88)">Join the pilot as a farmer or a buyer.</p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class="hl-btn hl-btn-primary hl-btn-lg" href="f?p=&APP_ID.:9002:&SESSION.::::P9002_ROLE:FARMER">I'm a farmer</a><a class="hl-btn hl-btn-secondary hl-btn-lg" href="f?p=&APP_ID.:9002:&SESSION.::::P9002_ROLE:BUYER">I'm a buyer</a></div></div></div></section></div>
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: html
        }
    )


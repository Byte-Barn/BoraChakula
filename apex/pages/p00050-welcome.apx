                databaseColumn: GRADE
                dataType: varchar2
            }
        )

        column COMPACT (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: COMPACT
                dataType: varchar2
            }
        )

        column QTY (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: QTY
                dataType: varchar2
            }
        )

        column DATE_LABEL (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DATE_LABEL
                dataType: varchar2
            }

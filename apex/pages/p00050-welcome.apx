    )

    region for-buyers (
        name: For buyers
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_d   number := hl_demo.featured_demand_id;
                  l_f   hl_fulfil_v%rowtype;
                  function kg (n number) return varchar2 is begin return to_char(n, 'FM999G999G990'); end;
                  function fill_bar (p_target number, p_matched number, p_pending number, p_legend boolean) return varchar2 is
                    l_unmatched number := greatest(p_target - p_matched - p_pending, 0);
                    l_html varchar2(4000);
                  begin
                    l_html := '<div class="hl-fill"><div class="hl-fill-head"><span class="hl-fill-total hl-num">' || kg(p_matched + p_pending)
                      || '<small> of ' || kg(p_target) || ' kg sourced</small></span><span class="hl-help">'
                      || round(p_matched / p_target * 100) || '% confirmed</span></div>'
                      || '<div class="hl-fill-track" role="img" aria-label="' || kg(p_matched) || ' kg matched, ' || kg(p_pending)
                      || ' pending, ' || kg(l_unmatched) || ' unmatched of ' || kg(p_target) || '">'
                      || '<span class="hl-fill-seg hl-fill-matched" style="width:' || to_char(round(p_matched / p_target * 100, 2), 'FM990D00', 'NLS_NUMERIC_CHARACTERS=''.,''') || '%"></span>'
                      || '<span class="hl-fill-seg hl-fill-pending" style="width:' || to_char(round(p_pending / p_target * 100, 2), 'FM990D00', 'NLS_NUMERIC_CHARACTERS=''.,''') || '%"></span></div>';
                    if p_legend then
                      l_html := l_html || '<ul class="hl-fill-legend"><li><span class="hl-key hl-key-matched"></span>Farmers confirmed <b class="hl-num">' || kg(p_matched)
                        || ' kg</b></li><li><span class="hl-key hl-key-pending"></span>Awaiting farmers <b class="hl-num">' || kg(p_pending)
                        || ' kg</b></li><li><span class="hl-key hl-key-unmatched"></span>Still open <b class="hl-num">' || kg(l_unmatched) || ' kg</b></li></ul>';
                    end if;
                    return l_html || '</div>';
                  end;
                begin
                  select * into l_f from hl_fulfil_v where demand_id = l_d;
                  return apex_plugin_util.replace_substitutions(p_escape => false, p_value => q'~<div class="hlc-root"><section id="buyers" class="hlc-pad" style="padding:96px 40px"><div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr));gap:64px;align-items:center"><div style="display:flex;flex-direction:column;gap:24px"><p class="hlc-eyebrow">For buyers</p><h2 class="hlc-h2" style="margin:0">Steady supply from farms you can name.</h2><p style="margin:0;font-size:18px;line-height:28px;color:var(--ink-muted)">Grocers, schools, hotels and processors post demand weeks ahead. See who supplies you, how much, and why they qualify.</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:16px"><div class="hlc-card" style="padding:20px;display:flex;flex-direction:column;gap:10px"><span class="hlc-icon-badge"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 2l6 3.25-6 3.25-6-3.25zM2 8.25l6 3.25 6-3.25M2 11.25l6 3.25 6-3.25"></path></svg></span><b style="font-weight:700">Matching you can read</b><span style="font-size:14px;color:var(--ink-muted)">Quantity, grade, timing and distance for every farm.</span></div><div class="hlc-card" style="padding:20px;display:flex;flex-direction:column;gap:10px"><span class="hlc-icon-badge"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 12.5a1.5 1.5 0 1 0 0-.01M12.5 3.5a1.5 1.5 0 1 0 0-.01M3.5 11V7.5a2 2 0 0 1 2-2h5M12.5 5v3.5a2 2 0 0 1-2 2h-5"></path></svg></span><b style="font-weight:700">One delivery</b><span style="font-size:14px;color:var(--ink-muted)">Many farms arrive on one truck on your date.</span></div></div><div><a class="hl-btn hl-btn-primary hl-btn-lg" href="f?p=&APP_ID.:31:&SESSION.">Post a demand<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></a></div></div><div style="position:relative"><div style="border-radius:28px;overflow:hidden;aspect-ratio:5/5.2;max-height:620px"><img src="#APP_FILES#images/photo-market-stall.jpg" alt="A market stall stacked with peppers, tomatoes, carrots, greens and fruit" class="hlc-photo"></div><div class="hlc-card hlc-lift" style="position:absolute;right:24px;bottom:24px;left:24px;max-width:380px;margin-left:auto;padding:18px 20px;display:flex;flex-direction:column;gap:12px"><div style="display:flex;justify-content:space-between;align-items:center;gap:8px"><b style="font:700 15px var(--font-display)">~'
                    || apex_escape.html('HL-D-' || lpad(l_f.demand_id, 4, '0') || ' · ' || l_f.crop_name)
                    || '</b><span class="hl-badge hl-badge-pending"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 4.5V8l2.5 1.5"></path></svg>Pending · ' || l_f.pending_farmers || '</span></div>'
                    || fill_bar(l_f.target_kg, l_f.matched_kg, l_f.pending_kg, false)
                    || '</div></div></div></section></div>');
                end;
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region impact-heading (
        name: Our impact
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root"><div class="hlc-pad hlc-on-dark" id="impact" style="position:relative;overflow:hidden;padding:96px 40px 176px;background:var(--forest-deep);color:#fff"><img src="#APP_FILES#images/photo-harvest-lettuce.jpg" alt="" class="hlc-photo" style="position:absolute;inset:0;object-position:50% 40%"><div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,36,27,.94) 0%,rgba(3,36,27,.8) 50%,rgba(3,36,27,.45) 100%)"></div><div style="position:relative;max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px;align-items:end"><div style="display:flex;flex-direction:column;gap:14px"><p class="hlc-eyebrow">Illustrative figures from the demo dataset</p><h2 class="hlc-h2" style="margin:0;color:#fff">What the pilot changes so far</h2></div><p style="margin:0;font-size:17px;line-height:27px;color:rgba(255,255,255,.82)">Totals across every demand in the demo dataset, including the tomato order above. Every figure says where it comes from and how it is calculated.</p></div></div></div>
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: html
        }
    )

    region impact-figures (
        name: Impact figures
        type: appTemplateComponent/hlStatCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.LABEL                                       as LABEL
                     , to_char(m.VALUE, 'FM999G999G990')             as VALUE_LABEL
                     , m.UNIT                                        as UNIT
                     , m.PROVENANCE                                  as PROVENANCE
                     , m.METHOD                                      as METHOD
                  from HL_IMPACT_METRICS_V m
                 where m.METRIC_KEY in ('PRODUCE_SOURCED', 'LOSS_AVOIDED', 'DISTANCE_SAVED', 'CO2_AVOIDED', 'FARMERS_REACHED')
                 order by case m.METRIC_KEY when 'PRODUCE_SOURCED' then 1 when 'LOSS_AVOIDED' then 2 when 'DISTANCE_SAVED' then 3 when 'CO2_AVOIDED' then 4 else 5 end
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-band-dark hlc-band-cards hlc-band-overlap
        }
        componentAppearance {
            display: report
        }
        settings {
            label: &LABEL.
            value: &VALUE_LABEL.
            unit: &UNIT.
            provenance: &PROVENANCE.
            method: &METHOD.
        }

        column LABEL (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column VALUE_LABEL (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: VALUE_LABEL
                dataType: varchar2
            }
        )

        column UNIT (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: UNIT
                dataType: varchar2
            }
        )

        column PROVENANCE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: PROVENANCE
                dataType: varchar2
            }
        )

        column METHOD (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: METHOD
                dataType: varchar2
            }
        )
    )

    region call-to-action (
        name: Call to action
        type: staticContent
        source {

                databaseColumn: IMAGE_URL
                dataType: varchar2
            }
        )

        column CROP (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: CROP
                dataType: varchar2
            }
        )

        column BUYER (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: BUYER
                dataType: varchar2
            }
        )


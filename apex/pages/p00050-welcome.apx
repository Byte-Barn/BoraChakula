    process send-signed-in-users-home (
        name: Send signed-in users to their own screen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- This page is the app's home: visitors see it, signed-in users
                -- (including right after login) go to the screen for their role
                if not apex_authentication.is_public_user then
                  apex_util.redirect_url(apex_page.get_url(
                    p_page => case hl_auth.role
                                when 'FARMER' then 20
                                when 'BUYER'  then 30
                                else 42
                              end));
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
)

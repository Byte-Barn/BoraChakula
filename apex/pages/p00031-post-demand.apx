page 31 (
    name: Post a Demand
    alias: POST-DEMAND
    title: Post a demand
    pageGroup: @dashboard
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
        cssClasses: hlc-app
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Canvas screen 4 (Post a demand). The form items and processes call HL_DEMAND_API.create_demand / save_draft / publish.
    }

    region header (
        name: Header
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                return '<div class="hlc-root"><header class="hl-ph"><a class="hl-ph-back hl-link" href="' || apex_page.get_url(p_page => 30) || '" style="text-decoration:none"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 8H3M7 4L3 8l4 4"></path></svg>Back to dashboard</a>'
                  || '<div class="hl-ph-row"><div class="hl-stack" style="gap:4px"><h1>Post a demand</h1><p>Tell farmers what you need before they harvest. Matching starts as soon as you post.</p></div></div></header></div>';
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-full
        }
    )
    region produce (
        name: Produce
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root" style="display:flex;gap:12px;align-items:baseline;margin-bottom:8px"><span style="font:500 21px/28px var(--font-display);color:var(--forest)">1</span><h2 style="margin:0;font-size:17px;line-height:24px">Produce</h2></div>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-left hlc-card hlc-form
        }
        settings {
            outputAs: html
        }
    )
    region before-you-post (
        name: Before you post
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_buyer number;
                  l_name  varchar2(150);
                  l_kra   varchar2(20);
                begin
                  select coalesce(hl_auth.buyer_id, max(f0.buyer_id)) into l_buyer from hl_fulfil_v f0 where f0.demand_id = hl_demo.featured_demand_id;
                  select buyer_name, kra_pin into l_name, l_kra from hl_buyers where buyer_id = l_buyer;
                  return '<div class="hlc-root" style="display:flex;flex-direction:column;gap:24px">'
                    || '<section aria-label="Before you post" class="hlc-card" style="border-color:var(--line-strong);padding:24px;display:flex;flex-direction:column;gap:20px">'
                    || '<p class="hl-overline" style="margin:0">Before you post</p>'
                    || '<div style="display:flex;flex-direction:column;gap:10px"><h3 style="margin:0;font-size:15px;line-height:24px">What happens next</h3>'
                    || '<ol style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;font-size:13px;line-height:20px;color:var(--ink-muted)">'
                    || '<li>We rank farmers whose harvest is ready before your delivery date.</li>'
                    || '<li>Farmers confirm their share. You see each one and why they qualify.</li>'
                    || '<li>We plan one pickup route for the day before delivery.</li></ol></div>'
                    || '<div style="display:flex;flex-direction:column;gap:8px">'
                    || '<button type="button" class="hl-btn hl-btn-primary hl-btn-lg hl-btn-block" onclick="apex.submit(''POST'')">Post demand<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></button>'
                    || '<button type="button" class="hl-btn hl-btn-secondary hl-btn-block" onclick="apex.submit(''SAVE_DRAFT'')">Save draft</button></div>'
                    || '<p style="margin:0;font-size:13px;line-height:20px;color:var(--ink-muted)">Delivery must be at least 7 days away, so farmers can plan. Drafts are not matched until you post them.</p></section>'
                    || '<section class="hlc-card" style="padding:20px 24px;display:flex;flex-direction:column;gap:8px">'
                    || '<h3 style="margin:0;font-size:15px;line-height:24px">Posting as ' || apex_escape.html(l_name) || '</h3>'
                    || '<p style="margin:0;font-size:13px;line-height:20px;color:var(--ink-muted)">' || case when l_kra is not null then 'KRA PIN and business registration on file. ' end
                    || 'Farmers see your name and order history before they confirm.</p>'
                    || '<div style="display:flex;gap:8px;align-items:center;font-size:13px;color:var(--ink-muted)">Automated KRA check <span class="hl-prov hl-prov-roadmap">Roadmap</span></div></section></div>';
                end;
                ```
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-right hlc-rows-3
        }
    )
    region delivery (
        name: Delivery
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root" style="display:flex;gap:12px;align-items:baseline;margin-bottom:8px"><span style="font:500 21px/28px var(--font-display);color:var(--forest)">2</span><h2 style="margin:0;font-size:17px;line-height:24px">Delivery</h2></div>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-left hlc-card hlc-form
        }
        settings {
            outputAs: html
        }
    )
    region price-notes (
        name: Price and notes
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root" style="display:flex;gap:12px;align-items:baseline;margin-bottom:8px"><span style="font:500 21px/28px var(--font-display);color:var(--forest)">3</span><h2 style="margin:0;font-size:17px;line-height:24px">Price and notes</h2></div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-left hlc-card hlc-form
        }
        settings {
            outputAs: html
        }
    )
    pageItem P31_DEMAND_ID (
        type: hidden
        layout {
            sequence: 5
            region: @produce
            slot: regionBody
        }
    )
    pageItem P31_BUYER_ID (
        type: selectList
        label {
            label: Buyer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-buyers
        }
        layout {
            sequence: 10
            region: @produce
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.buyer_id is null
        }
    )
    pageItem P31_CROP_ID (
        type: radioGroup
        label {
            label: Crop
            alignment: right
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sharedComponent
            lov: @lov-crops
        }
        layout {
            sequence: 20
            region: @produce
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            cssClasses: hlc-crop-tiles
        }
        validation {
            valueRequired: true
        }
    )
    pageItem P31_QTY_KG (
        type: numberField
        label {
            label: Quantity (kg)
            alignment: right
        }
        layout {
            sequence: 40
            region: @produce
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
    )
    pageItem P31_GRADE (
        type: radioGroup
        label {
            label: Quality grade
            alignment: right
        }
        settings {
            noOfCols: 10
        }
        lov {
            type: sharedComponent
            lov: @lov-grades
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @produce
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            cssClasses: hlc-grade-chips
        }
        validation {
            valueRequired: true
        }
    )
    pageItem P31_NEED_BY (
        type: datePicker
        label {
            label: Delivery date (at least 7 days away)
            alignment: right
        }
        layout {
            sequence: 60
            region: @delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
    )
    pageItem P31_WINDOW (
        type: selectList
        label {
            label: Receiving time
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-receiving-windows
        }
        layout {
            sequence: 70
            region: @delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
    )
    pageItem P31_PRICE_PER_KG (
        type: numberField
        label {
            label: Price (KES/kg)
            alignment: right
        }
        layout {
            sequence: 50
            region: @price-notes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
    )
    pageItem P31_NOTES (
        type: textarea
        label {
            label: Notes for farmers
            alignment: right
        }
        layout {
            sequence: 80
            region: @price-notes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
    )
    process load-draft (
        name: Load a saved draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for d in (select f.buyer_id, f.crop_id, f.grade_required, f.target_kg, f.price_per_kg,
                                 f.need_by_date, f.receiving_window, x.notes
                            from hl_fulfil_v f
                            join hl_demands x on x.demand_id = f.demand_id
                           where f.demand_id = to_number(:P31_DEMAND_ID)
                             and f.status = 'DRAFT'
                             and (hl_auth.buyer_id is null or f.buyer_id = hl_auth.buyer_id)) loop
                  :P31_BUYER_ID     := d.buyer_id;
                  :P31_CROP_ID      := d.crop_id;
                  :P31_GRADE        := d.grade_required;
                  :P31_QTY_KG       := d.target_kg;
                  :P31_PRICE_PER_KG := d.price_per_kg;
                  :P31_NEED_BY      := to_char(d.need_by_date);
                  :P31_WINDOW       := d.receiving_window;
                  :P31_NOTES        := d.notes;
                end loop;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P31_DEMAND_ID is not null and :P31_CROP_ID is null
        }
    )
    process defaults (
        name: Suggest values for a new demand
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P31_DEMAND_ID is null and :P31_CROP_ID is null then
                  :P31_GRADE    := 'A';
                  :P31_NEED_BY  := to_char(trunc(sysdate) + 14);
                  :P31_WINDOW   := '06-10';
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    process save-draft (
        name: Save draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P31_DEMAND_ID := hl_demand_api.save_draft(
                  p_demand_id        => to_number(:P31_DEMAND_ID),
                  p_buyer_id         => coalesce(hl_auth.buyer_id, to_number(:P31_BUYER_ID)),
                  p_crop_id          => to_number(:P31_CROP_ID),
                  p_grade            => :P31_GRADE,
                  p_quantity_kg      => to_number(:P31_QTY_KG),
                  p_price_per_kg     => to_number(:P31_PRICE_PER_KG),
                  p_need_by_date     => to_date(:P31_NEED_BY),
                  p_notes            => :P31_NOTES,
                  p_receiving_window => :P31_WINDOW);
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE_DRAFT'
        }
    )
    process post-demand (
        name: Post demand and show the matches
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number := to_number(:P31_DEMAND_ID);
                begin
                  if l_id is null then
                    l_id := hl_demand_api.create_demand(
                      p_buyer_id         => coalesce(hl_auth.buyer_id, to_number(:P31_BUYER_ID)),
                      p_crop_id          => to_number(:P31_CROP_ID),
                      p_grade            => :P31_GRADE,
                      p_quantity_kg      => to_number(:P31_QTY_KG),
                      p_price_per_kg     => to_number(:P31_PRICE_PER_KG),
                      p_need_by_date     => to_date(:P31_NEED_BY),
                      p_notes            => :P31_NOTES,
                      p_receiving_window => :P31_WINDOW);
                  else
                    -- A saved draft: store the latest values, then apply every rule and match
                    l_id := hl_demand_api.save_draft(
                      p_demand_id        => l_id,
                      p_buyer_id         => coalesce(hl_auth.buyer_id, to_number(:P31_BUYER_ID)),
                      p_crop_id          => to_number(:P31_CROP_ID),
                      p_grade            => :P31_GRADE,
                      p_quantity_kg      => to_number(:P31_QTY_KG),
                      p_price_per_kg     => to_number(:P31_PRICE_PER_KG),
                      p_need_by_date     => to_date(:P31_NEED_BY),
                      p_notes            => :P31_NOTES,
                      p_receiving_window => :P31_WINDOW);
                    hl_demand_api.publish(p_demand_id => l_id);
                  end if;
                  commit;
                  apex_util.redirect_url(apex_page.get_url(
                    p_page        => 32,
                    p_clear_cache => '31,32',
                    p_items       => 'P32_DEMAND_ID',
                    p_values      => l_id));
                end;
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'POST'
        }
    )

    process role-gate (
        name: Only buyers and operations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Other roles go to their own home page; unmapped users to the landing page
                if nvl(hl_auth.role, '-') not in ('BUYER', 'OPS') then
                  apex_util.redirect_url(apex_page.get_url(
                    p_page => case hl_auth.role when 'FARMER' then 20 when 'BUYER' then 30 else 50 end));
                end if;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
    )
)

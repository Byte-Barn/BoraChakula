    entry my-farm (
        label: My farm
        icon {
            imageIconCssClasses: fa-leaf
        }
        layout {
            sequence: 1
        }
        link {
            target: {
                page: 20
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_farmer or hl_auth.is_ops
        }
    )


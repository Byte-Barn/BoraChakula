page 12 (
    name: Confirm Match
    alias: CONFIRM-MATCH
    title: Confirm Match
    pageGroup: @matching-and-logistics
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Updates HL_MATCHES.STATUS; a database trigger appends each confirmation, rejection or delivery to the HL_AGREEMENTS blockchain table.
    }
    
    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )
    
    region match-confirmation (
        name: Match Confirmation
        type: form
        source {
            location: localDatabase
            tableName: HL_MATCHES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Shows the allocated quantity and records whether the farmer confirmed, rejected or delivered.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )
    
    
    pageItem P12_ALLOCATED_KG (
        type: displayOnly
        label {
            label: Allocated (kg)
            alignment: right
        }
        layout {
            sequence: 20
            region: @match-confirmation
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @match-confirmation
            column: ALLOCATED_KG
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P12_MATCH_ID (
        type: displayOnly
        label {
            label: Match ID
            alignment: right
        }
        layout {
            sequence: 10
            region: @match-confirmation
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @match-confirmation
            column: MATCH_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P12_MATCH_REASON (
        type: displayOnly
        label {
            label: Why Matched
            alignment: right
        }
        layout {
            sequence: 30
            region: @match-confirmation
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @match-confirmation
            column: MATCH_REASON
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P12_STATUS (
        type: radioGroup
        label {
            label: Farmer Answer
            alignment: right
        }
        settings {
            noOfCols: 10
        }
        lov {
            type: sharedComponent
            lov: @lov-match-status
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @match-confirmation
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @match-confirmation
            column: STATUS
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    
    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 2
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        
        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )
    )
    
    button record-answer (
        buttonName: RECORD-ANSWER
        label: Record Answer
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_MATCH_ID
        }
        
    )
    
    
    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P12_MATCH_ID
        }
        execution {
            sequence: 20
        }
    )
    
    process initialize-form-match-confirmation (
        name: Initialize form Match Confirmation
        type: formInitialization
        formRegion: @match-confirmation
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    
    process process-form-match-confirmation (
        name: Process form Match Confirmation
        type: formAutoRowProcessing
        formRegion: @match-confirmation
        execution {
            sequence: 10
        }
    )
    
    
)


    region not-matched-heading (
        name: Not matched heading
        type: staticContent
        source {
            htmlCode:
                ```html
                <h2 class="hlc-section-title">Not matched</h2>
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-left hlc-root
        }
        settings {
            outputAs: html
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from hl_near_miss_v where demand_id = :P32_DEMAND_ID
        }
    )
    region not-matched (
        name: Not matched
        type: appTemplateComponent/hlMatchCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '—'                                                                         as RANK
                     , 'unmatched'                                                                   as STATUS
                     , 'Not matched'                                                                 as STATUS_TEXT
                     , n.FARMER_NAME                                                                 as FARMER
                     , n.FARMER_LOCATION                                                             as LOCATION
                     , n.DISTANCE_KM || ' km to delivery'                                            as DISTANCE
                     , to_char(n.HARVEST_FROM, 'DD Mon') || '–' || to_char(n.HARVEST_TO, 'DD Mon')   as HARVEST
                     , to_char(n.AVAILABLE_KG, 'FM999G999G990') || ' kg'                             as QTY
                     , 'available'                                                                   as QTY_LABEL
                     , n.GRADE                                                                       as GRADE
                     , 'Y'                                                                           as OPEN_REASONS
                     , 'Why this farmer was not matched'                                             as REASONS_TITLE
                     , 'Quantity'       as R1_LABEL, n.REASON_QTY    as R1_DETAIL, n.REASON_QTY_STATE    as R1_STATE
                     , 'Grade'          as R2_LABEL, n.REASON_GRADE  as R2_DETAIL, n.REASON_GRADE_STATE  as R2_STATE
                     , 'Harvest window' as R3_LABEL, n.REASON_WINDOW as R3_DETAIL, n.REASON_WINDOW_STATE as R3_STATE
                     , 'Distance'       as R4_LABEL, n.REASON_DIST   as R4_DETAIL, n.REASON_DIST_STATE   as R4_STATE
                  from HL_NEAR_MISS_V n
                 where n.DEMAND_ID = :P32_DEMAND_ID
                 order by n.DISTANCE_KM
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-left
        }
        componentAppearance {
            display: report
        }
        settings {
            rank: &RANK.
            status: &STATUS.
            statusText: &STATUS_TEXT.
            farmer: &FARMER.
            location: &LOCATION.
            distance: &DISTANCE.
            harvest: &HARVEST.
            qty: &QTY.
            qtyLabel: &QTY_LABEL.
            grade: &GRADE.
            open: &OPEN_REASONS.
            reasonsTitle: &REASONS_TITLE.
            reason1Label: &R1_LABEL.
            reason1Detail: &R1_DETAIL.
            reason1State: &R1_STATE.
            reason2Label: &R2_LABEL.
            reason2Detail: &R2_DETAIL.
            reason2State: &R2_STATE.
            reason3Label: &R3_LABEL.
            reason3Detail: &R3_DETAIL.
            reason3State: &R3_STATE.
            reason4Label: &R4_LABEL.
            reason4Detail: &R4_DETAIL.
            reason4State: &R4_STATE.
        }


        column ACTION2_URL (
            layout {
                sequence: 260
            }
            source {
                databaseColumn: ACTION2_URL
                dataType: varchar2
            }
        )

        column ACTION2_LABEL (
            layout {
                sequence: 270
            }
            source {
                databaseColumn: ACTION2_LABEL
                dataType: varchar2
            }
        )

        column ACTION_NOTE (
            layout {
                sequence: 280
            }

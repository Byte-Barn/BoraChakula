    region page-state (
        name: Page state
        type: staticContent
        source {
            htmlCode:
                ```html
                <span></span>
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-full
        }
        settings {
            outputAs: html
        }
    )
    pageItem P32_DEMAND_ID (
        type: hidden
        layout {
            sequence: 10
            region: @page-state
            slot: regionBody
        }
    )

    pageItem P32_MATCH_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @page-state
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    process default-demand (
        name: Default to the featured demand
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P32_DEMAND_ID := coalesce(:P32_DEMAND_ID, hl_demo.featured_demand_id);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process confirm-match (
        name: Farmer confirmed
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hl_match_pkg.confirm(p_match_id => to_number(:P32_MATCH_ID));
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'CONFIRM'
        }
    )

    process decline-match (
        name: Farmer declined
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hl_match_pkg.decline(p_match_id => to_number(:P32_MATCH_ID));
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'DECLINE'
        }
    )

    process run-matching (
        name: Run matching again
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hl_match_pkg.run(p_demand_id => to_number(:P32_DEMAND_ID));
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'RUN'
        }
    )
)

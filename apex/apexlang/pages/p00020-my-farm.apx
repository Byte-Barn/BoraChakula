page 20 (
    name: My Farm
    alias: MY-FARM
    title: My farm
    pageGroup: @dashboard
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
        cssClasses: hlc-phone
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript
            // Bottom navigation: mark the tab whose section is in view
            (function () {
              var links = Array.prototype.slice.call(document.querySelectorAll('.hlc-bottom-nav a[href^="#"]'));
              if (!links.length || !('IntersectionObserver' in window)) { return; }
              var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) { return; }
                  links.forEach(function (a) {
                    if (a.getAttribute('href') === '#' + entry.target.id) { a.setAttribute('aria-current', 'location'); }
                    else { a.removeAttribute('aria-current'); }
                  });
                });
              }, { rootMargin: '-35% 0px -60% 0px' });
              links.forEach(function (a) {
                var section = document.getElementById(a.getAttribute('href').slice(1));
                if (section) { observer.observe(section); }
              });
            })();
            ```
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Canvas screen 2 (Farmer, phone first). Offers to accept or decline, harvest registration with crop tiles, my harvests and data rights; processes call HL_MATCH_PKG, HL_HARVEST_API and HL_FARMER_API.
    }

    region farmer-header (
        name: Farmer header
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_name varchar2(150);
                  l_place varchar2(200);
                begin
                  select max(full_name), max(location_name || ', ' || county) into l_name, l_place from hl_farmers where farmer_id = hl_auth.farmer_id;
                  return apex_plugin_util.replace_substitutions(p_escape => false, p_value =>
                       '<header class="hlc-root hlc-on-dark" style="position:relative;height:250px;overflow:hidden;color:#fff;border-radius:0 0 28px 28px;background:var(--forest-deep)">'
                    || '<img src="#APP_FILES#images/photo-farmer-sunhat.jpg" alt="A farmer holding a basket of vegetables in her field" class="hlc-photo" style="position:absolute;inset:0;object-position:50% 28%">'
                    || '<div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,36,27,.35) 0%,rgba(3,36,27,.88) 100%)"></div>'
                    || '<div style="position:relative;height:100%;box-sizing:border-box;padding:16px 20px 22px;display:flex;flex-direction:column;justify-content:space-between">'
                    || '<div style="display:flex;justify-content:space-between;align-items:center"><a class="hl-logo hl-logo-inverse" href="' || apex_page.get_url(p_page => 50) || '" aria-label="HarvestLink home">'
                    || '<svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false"><path d="M16 29C8 26 3.5 18.5 4.5 8c8 2 12.5 8 11.5 21z" fill="currentColor"></path><path d="M16 29c8-3 12.5-10.5 11.5-21-8 2-12.5 8-11.5 21z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path><circle cx="16" cy="4.5" r="2.75" fill="currentColor"></circle></svg>'
                    || '<span><span class="hl-logo-word" style="font-size:18px;line-height:20px;display:block">HarvestLink</span></span></a>'
                    || '<a href="' || apex_plugin_util.replace_substitutions('&LOGOUT_URL.', p_escape => false) || '" style="font-size:13px;font-weight:600;color:#fff;text-decoration:none">Sign out</a></div>'
                    || '<div style="display:flex;flex-direction:column;gap:6px"><b class="hlc-role-chip hlc-role-farmer">Farmer</b><p class="hlc-eyebrow">' || apex_escape.html(nvl(l_place, 'Your farm')) || '</p>'
                    || '<h1 style="margin:0;font:800 28px/34px var(--font-display);letter-spacing:-0.02em;color:#fff">Habari, ' || apex_escape.html(regexp_substr(nvl(l_name, 'farmer'), '^\S+')) || '</h1>'
                    || '<p style="margin:0;font-size:15px;line-height:22px;color:rgba(255,255,255,.88)">We find buyers before you pick.</p></div></div></header>');
                end;
                ```
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-farm-head
        }
    )
    region offers (
        name: Offers from buyers
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.MATCH_ID as MATCH_ID
                     , o.BUYER_NAME || ' · ' || o.BUYER_LOCATION as OVERLINE
                     , to_char(o.ALLOCATED_KG, 'FM999G999G990') || ' kg of Grade ' || o.GRADE || ' ' || o.CROP_NAME as TITLE
                     , 'KES ' || to_char(o.PRICE_PER_KG, 'FM999G990') || '/kg · KES '
                       || to_char(o.OFFER_VALUE_KES, 'FM999G999G990') || ' · deliver by '
                       || to_char(o.NEED_BY_DATE, 'Dy DD Mon') as MISC
                     , '<span class="hl-badge hl-badge--' || lower(o.UI_STATUS) || '">'
                       || case o.UI_STATUS when 'MATCHED' then 'You confirmed'
                                           when 'PENDING' then 'Waiting for your answer'
                                           else 'You declined' end
                       || '</span>'
                       -- Select AI sentence in Kiswahili, only when AI wrote it
                       || case when hl_ai.explain_match(o.MATCH_ID, 'sw') is not null
                                 and hl_ai.explained_by(o.MATCH_ID, 'sw') = 'AI'
                               then '<p class="hl-why"><span class="hl-ai" title="Imeandikwa na Select AI">AI</span> '
                                    || apex_escape.html(hl_ai.explain_match(o.MATCH_ID, 'sw')) || '</p>' end
                       || '<ul class="hl-reasons hl-reasons--plain">'
                       || '<li>' || apex_escape.html(o.REASON_WINDOW) || '</li>'
                       || '<li>' || apex_escape.html(o.REASON_DIST) || '</li>'
                       || '</ul>'
                       || case when o.AGREEMENT_HASH is not null
                               then '<p class="hl-hash">Agreement recorded on the ledger · <code>'
                                    || o.AGREEMENT_HASH || '</code></p>' end
                       || case when o.UI_STATUS = 'PENDING'
                               then '<div class="hl-actions">'
                                    || '<button type="button" class="t-Button t-Button--hot" '
                                    || 'onclick="apex.submit({request:''ACCEPT'',set:{P20_MATCH_ID:''' || o.MATCH_ID || '''}});">'
                                    || 'Accept ' || to_char(o.ALLOCATED_KG, 'FM999G999G990') || ' kg</button>'
                                    || '<button type="button" class="t-Button" '
                                    || 'onclick="apex.submit({request:''DECLINE'',set:{P20_MATCH_ID:''' || o.MATCH_ID || '''}});">'
                                    || 'Decline</button>'
                                    || '</div>' end as BODY_HTML
                from HL_MY_OFFERS_V o
                where o.UI_STATUS <> 'DECLINED'
                  -- Past deliveries are history, not offers
                  and o.NEED_BY_DATE >= trunc(sysdate)
                order by case o.UI_STATUS when 'PENDING' then 0 else 1 end, o.NEED_BY_DATE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-phone-card
        }
        advanced {
            htmlDomId: offers
        }
        accessibility {
            landmarkType: region
        }
        messages {
            whenNoDataFound: No offers yet. We match your registered harvests to buyers and show their offers here.
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            description: &BODY_HTML!RAW.
            miscellaneous: &MISC.
        }

        column BODY_HTML (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BODY_HTML
                dataType: varchar2
            }
        )

        column MATCH_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: MATCH_ID
                dataType: number
                primaryKey: true
            }
        )

        column MISC (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MISC
                dataType: varchar2
            }
        )

        column OVERLINE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )
    region register-harvest (
        name: Register a harvest
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-phone-card hlc-farm-side
        }
        advanced {
            htmlDomId: register-harvest
        }
        settings {
            outputAs: text
        }
        comments {
            comments: Tell buyers what you expect to harvest, before you harvest.
        }
    )
    region my-harvests (
        name: My harvests
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.HARVEST_ID as HARVEST_ID
                     , 'Grade ' || h.GRADE || ' · ' || initcap(h.STATUS) as OVERLINE
                     , h.CROP_NAME || ' · ' || to_char(h.EXPECTED_QTY_KG, 'FM999G999G990') || ' kg' as TITLE
                     , to_char(h.HARVEST_FROM, 'DD Mon') || '–' || to_char(h.HARVEST_TO, 'DD Mon')
                       || ' · ' || to_char(h.AVAILABLE_KG, 'FM999G999G990') || ' kg not yet promised' as MISC
                from HL_MY_HARVESTS_V h
                where h.HARVEST_TO >= trunc(sysdate) - 7
                order by h.HARVEST_FROM
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-phone-card
        }
        advanced {
            htmlDomId: my-harvests
        }
        accessibility {
            landmarkType: region
        }
        messages {
            whenNoDataFound: No harvests yet. Register your first harvest to get matched with buyers.
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            miscellaneous: &MISC.
        }

        column HARVEST_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: HARVEST_ID
                dataType: number
                primaryKey: true
            }
        )

        column MISC (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MISC
                dataType: varchar2
            }
        )

        column OVERLINE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )
    region your-data (
        name: Your data
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.CONSENT_VERSION as CONSENT_VERSION
                     , 'Data protection notice ' || c.CONSENT_VERSION as OVERLINE
                     , 'What you agreed to' as TITLE
                     , '<p class="hl-method">' || apex_escape.html(c.CONSENT_TEXT) || '</p>'
                       || '<p class="hl-method">Kenya Data Protection Act, 2019: download a copy of everything we hold about you, '
                       || 'or delete your account. Agreements already on the ledger keep your name until they expire.</p>' as BODY_HTML
                from HL_CONSENT_TEXTS c
                order by c.PUBLISHED_AT desc
                fetch first 1 row only
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hlc-phone-card
        }
        advanced {
            htmlDomId: your-data
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            description: &BODY_HTML!RAW.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_farmer
        }

        column BODY_HTML (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: BODY_HTML
                dataType: varchar2
            }
        )

        column CONSENT_VERSION (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: CONSENT_VERSION
                dataType: varchar2
                primaryKey: true
            }
        )

        column OVERLINE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )
    region bottom-nav (
        name: Bottom navigation
        type: staticContent
        source {
            htmlCode:
                ```html
                <nav class="hlc-root hlc-bottom-nav" aria-label="Farmer navigation"><a href="#my-harvests"><svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 14V7.5M8 7.5C8 4.5 5.5 3 2.5 3c0 3 2.5 4.5 5.5 4.5zM8 9.5c0-2.75 2.25-4.25 5.5-4.25 0 2.75-2.25 4.25-5.5 4.25z"></path></svg>My harvests</a><a href="#register-harvest"><svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10"></path></svg>Register</a><a href="#offers"><svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.75 4h7.5v6.5h-7.5zM9.25 6.5h3l2 2.25v1.75h-5M4.5 12.5a1.25 1.25 0 1 0 0-.01M11.5 12.5a1.25 1.25 0 1 0 0-.01"></path></svg>Offers</a><a href="f?p=&APP_ID.:41:&SESSION."><svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.75 4h7.5v6.5h-7.5zM9.25 6.5h3l2 2.25v1.75h-5M4.5 12.5a1.25 1.25 0 1 0 0-.01M11.5 12.5a1.25 1.25 0 1 0 0-.01"></path></svg>Pickups</a></nav>
                ```
        }
        layout {
            sequence: 99
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: html
        }
    )
    pageItem P20_MATCH_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 5
            region: @register-harvest
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )
    pageItem P20_FARMER_ID (
        type: selectList
        label {
            label: Farmer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-farmers
        }
        layout {
            sequence: 10
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.farmer_id is null
        }
    )
    pageItem P20_CROP_ID (
        type: radioGroup
        label {
            label: Crop
            alignment: right
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sharedComponent
            lov: @lov-crops
        }
        layout {
            sequence: 20
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            cssClasses: hlc-crop-tiles
        }
    )
    pageItem P20_GRADE (
        type: radioGroup
        label {
            label: Grade
            alignment: right
        }
        settings {
            noOfCols: 10
        }
        lov {
            type: sharedComponent
            lov: @lov-grades
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
    )
    pageItem P20_QTY_KG (
        type: numberField
        label {
            label: Expected quantity (kg)
            alignment: right
        }
        layout {
            sequence: 40
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
    )
    pageItem P20_FROM (
        type: datePicker
        label {
            label: Harvest from
            alignment: right
        }
        layout {
            sequence: 50
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
    )
    pageItem P20_TO (
        type: datePicker
        label {
            label: Harvest to
            alignment: right
        }
        layout {
            sequence: 60
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
    )
    pageItem P20_NOTES (
        type: textarea
        label {
            label: Notes
            alignment: right
        }
        layout {
            sequence: 70
            region: @register-harvest
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
    )
    button register (
        buttonName: REGISTER
        label: Register harvest
        layout {
            sequence: 10
            region: @register-harvest
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )
    button download-data (
        buttonName: DOWNLOAD_DATA
        label: Download my data
        layout {
            sequence: 10
            region: @your-data
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )
    button delete-account (
        buttonName: DELETE_ACCOUNT
        label: Delete my account
        layout {
            sequence: 20
            region: @your-data
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Delete your HarvestLink account? Your harvests and open offers are removed and you are signed out. This cannot be undone.
            style: danger
        }
    )
    process download-data (
        name: Download my data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_json clob;
                begin
                  select DATA_JSON into l_json from HL_MY_DATA_V;
                  sys.owa_util.mime_header('application/json', false, 'UTF-8');
                  sys.htp.p('Content-Disposition: attachment; filename="harvestlink-my-data.json"');
                  sys.owa_util.http_header_close;
                  apex_util.prn(p_clob => l_json, p_escape => false);
                  apex_application.stop_apex_engine;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'DOWNLOAD_DATA' and hl_auth.is_farmer
        }
    )
    process delete-account (
        name: Delete my account
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hl_farmer_api.delete_account(p_farmer_id => hl_auth.farmer_id);
                commit;
                apex_authentication.logout(p_session_id => :APP_SESSION, p_app_id => :APP_ID);
                ```
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'DELETE_ACCOUNT' and hl_auth.is_farmer
        }
    )
    process accept-offer (
        name: Accept offer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hl_match_pkg.confirm(p_match_id => to_number(:P20_MATCH_ID));
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'ACCEPT'
        }
    )
    process decline-offer (
        name: Decline offer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hl_match_pkg.decline(p_match_id => to_number(:P20_MATCH_ID));
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'DECLINE'
        }
    )
    process register-harvest (
        name: Register harvest
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number;
                begin
                  -- Checked here, not as required items, so Accept and Decline
                  -- submit without filling in this form
                  if :P20_CROP_ID is null or :P20_GRADE is null or :P20_QTY_KG is null
                     or :P20_FROM is null or :P20_TO is null then
                    raise_application_error(-20291, 'Choose a crop and grade, and give the quantity and harvest dates');
                  end if;
                  l_id := hl_harvest_api.register(
                    p_farmer_id       => coalesce(hl_auth.farmer_id, to_number(:P20_FARMER_ID)),
                    p_crop_id         => to_number(:P20_CROP_ID),
                    p_grade           => :P20_GRADE,
                    p_expected_qty_kg => to_number(:P20_QTY_KG),
                    p_harvest_from    => to_date(:P20_FROM),
                    p_harvest_to      => to_date(:P20_TO),
                    p_notes           => :P20_NOTES);
                  :P20_CROP_ID := null;
                  :P20_QTY_KG  := null;
                  :P20_FROM    := null;
                  :P20_TO      := null;
                  :P20_NOTES   := null;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'REGISTER'
        }
    )

    process role-gate (
        name: Only farmers and operations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Other roles go to their own home page; unmapped users to the landing page
                if nvl(hl_auth.role, '-') not in ('FARMER', 'OPS') then
                  apex_util.redirect_url(apex_page.get_url(
                    p_page => case hl_auth.role when 'FARMER' then 20 when 'BUYER' then 30 else 50 end));
                end if;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
    )
)

page 9003 (
    name: Reset Password
    alias: RESET-PASSWORD
    title: Choose a new password · HarvestLink
    appearance {
        pageTemplate: @/blank
        templateOptions: #DEFAULT#
        cssClasses: hlc-page hlc-auth
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Opened from the reset email (RESET_URL). Sets a new password with HL_ACCOUNT_API.reset_password.
    }

    region auth-head (
        name: Header
        type: staticContent
        source {
            htmlCode:
                ```html
                <header class="hlc-root hlc-auth-head"><a class="hl-logo" href="f?p=&APP_ID.:50:&SESSION." aria-label="HarvestLink home"><svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false"><path d="M16 29C8 26 3.5 18.5 4.5 8c8 2 12.5 8 11.5 21z" fill="currentColor"></path><path d="M16 29c8-3 12.5-10.5 11.5-21-8 2-12.5 8-11.5 21z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path><circle cx="16" cy="4.5" r="2.75" fill="currentColor"></circle></svg><span class="hl-logo-word">HarvestLink</span></a><a class="hlc-auth-back" href="f?p=&APP_ID.:9000:&SESSION.">Sign in</a></header>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: html
        }
    )

    region new-password (
        name: New password
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root"><h1 class="hlc-auth-title">Choose a new password</h1><p class="hlc-auth-lead">At least 10 characters, not only numbers.</p></div>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-form hlc-auth-card
        }
        settings {
            outputAs: html
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P9003_DONE is null
        }
    )
    pageItem P9003_TOKEN (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 1
            region: @new-password
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )
    pageItem P9003_PASSWORD (
        type: password
        label {
            label: New password
            alignment: right
        }
        layout {
            sequence: 10
            region: @new-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 128
        }
        advanced {
            customAttributes: autocomplete="new-password"
        }
        sessionState {
            storage: request
        }
    )
    pageItem P9003_CONFIRM (
        type: password
        label {
            label: Type it again
            alignment: right
        }
        layout {
            sequence: 20
            region: @new-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 128
        }
        advanced {
            customAttributes: autocomplete="new-password"
        }
        sessionState {
            storage: request
        }
    )

    region reset-actions (
        name: Actions
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root hlc-auth-actions"><button type="button" class="hl-btn hl-btn-primary hl-btn-lg" onclick="apex.submit('RESET');">Save new password</button></div>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-auth-card hlc-auth-foot
        }
        settings {
            outputAs: html
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P9003_DONE is null
        }
    )

    region done (
        name: Done
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hlc-root"><h1 class="hlc-auth-title">Password changed</h1><p class="hlc-auth-lead">Sign in with your new password.</p><div class="hlc-auth-actions"><a class="hl-btn hl-btn-primary hl-btn-lg" href="f?p=&APP_ID.:9000:&SESSION.">Sign in</a></div></div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hlc-form hlc-auth-card
        }
        settings {
            outputAs: html
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P9003_DONE = 'Y'
        }
    )
    pageItem P9003_DONE (
        type: hidden
        layout {
            sequence: 1
            region: @done
            slot: regionBody
        }
    )

    process reset (
        name: Save the new password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P9003_PASSWORD is null or :P9003_PASSWORD <> nvl(:P9003_CONFIRM, '-') then
                    raise_application_error(-20704, 'The two passwords do not match');
                  end if;
                  hl_account_api.reset_password(:P9003_TOKEN, :P9003_PASSWORD);
                  commit;
                  :P9003_DONE := 'Y';
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'RESET'
        }
    )
)

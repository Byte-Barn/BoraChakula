page 3 (
    name: Demand Form
    alias: DEMAND-FORM
    title: Demand Form
    pageGroup: @marketplace
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Maintains HL_DEMANDS rows; database triggers re-run matching after every save or delete.
    }
    
    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )
    
    region demand-form (
        name: Demand Form
        type: form
        source {
            location: localDatabase
            tableName: HL_DEMANDS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Captures buyer, crop, grade, quantity, price and need-by date for a produce demand.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )
    
    
    pageItem P3_BUYER_ID (
        type: selectList
        label {
            label: Buyer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-buyers
        }
        layout {
            sequence: 20
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: BUYER_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_CROP_ID (
        type: selectList
        label {
            label: Crop
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-crops
        }
        layout {
            sequence: 30
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: CROP_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_DELIVERY_LAT (
        type: numberField
        label {
            label: Delivery Latitude
            alignment: right
        }
        layout {
            sequence: 90
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @demand-form
            column: DELIVERY_LAT
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_DELIVERY_LON (
        type: numberField
        label {
            label: Delivery Longitude
            alignment: right
        }
        layout {
            sequence: 100
            region: @demand-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @demand-form
            column: DELIVERY_LON
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_DEMAND_ID (
        type: displayOnly
        label {
            label: Demand ID
            alignment: right
        }
        layout {
            sequence: 10
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @demand-form
            column: DEMAND_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_GRADE_REQUIRED (
        type: radioGroup
        label {
            label: Minimum Grade
            alignment: right
        }
        settings {
            noOfCols: 10
        }
        lov {
            type: sharedComponent
            lov: @lov-grades
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: GRADE_REQUIRED
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_NEED_BY_DATE (
        type: datePicker
        label {
            label: Need By
            alignment: right
        }
        layout {
            sequence: 70
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: NEED_BY_DATE
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_NOTES (
        type: textarea
        label {
            label: Notes
            alignment: right
        }
        layout {
            sequence: 110
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @demand-form
            column: NOTES
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_PRICE_PER_KG (
        type: numberField
        label {
            label: Price (KES/kg)
            alignment: right
        }
        layout {
            sequence: 60
            region: @demand-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: PRICE_PER_KG
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_QUANTITY_KG (
        type: numberField
        label {
            label: Quantity (kg)
            alignment: right
        }
        layout {
            sequence: 50
            region: @demand-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: QUANTITY_KG
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P3_STATUS (
        type: selectList
        label {
            label: Status
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-demand-status
        }
        layout {
            sequence: 80
            region: @demand-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @demand-form
            column: STATUS
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    
    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DEMAND_ID
        }
        
    )
    
    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        
        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )
    )
    
    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_DEMAND_ID
        }
        
    )
    
    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DEMAND_ID
        }
        
    )
    
    
    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P3_DEMAND_ID
        }
        execution {
            sequence: 20
        }
    )
    
    process initialize-form-demand-form (
        name: Initialize form Demand Form
        type: formInitialization
        formRegion: @demand-form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    
    process process-form-demand-form (
        name: Process form Demand Form
        type: formAutoRowProcessing
        formRegion: @demand-form
        execution {
            sequence: 10
        }
    )
    
    
)


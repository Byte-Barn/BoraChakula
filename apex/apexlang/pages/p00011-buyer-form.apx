page 11 (
    name: Buyer Form
    alias: BUYER-FORM
    title: Buyer Form
    pageGroup: @participants
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Maintains HL_BUYERS rows including delivery coordinates and accepted grades used by matching.
    }
    
    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )
    
    region buyer-form (
        name: Buyer Form
        type: form
        source {
            location: localDatabase
            tableName: HL_BUYERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Captures buyer identity, channel, contact, location, accepted grades and verification.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )
    
    
    pageItem P11_ACCEPTED_GRADES (
        type: textField
        label {
            label: Accepted Grades
            alignment: right
        }
        layout {
            sequence: 100
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: ACCEPTED_GRADES
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_BUYER_ID (
        type: displayOnly
        label {
            label: Buyer ID
            alignment: right
        }
        layout {
            sequence: 10
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @buyer-form
            column: BUYER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_BUYER_NAME (
        type: textField
        label {
            label: Buyer Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: BUYER_NAME
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_BUYER_TYPE (
        type: selectList
        label {
            label: Buyer Type
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-buyer-types
        }
        layout {
            sequence: 30
            region: @buyer-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: BUYER_TYPE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_CONTACT_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 50
            region: @buyer-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @buyer-form
            column: CONTACT_EMAIL
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_CONTACT_PHONE (
        type: textField
        label {
            label: Phone
            alignment: right
        }
        layout {
            sequence: 40
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @buyer-form
            column: CONTACT_PHONE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_COUNTY (
        type: textField
        label {
            label: County
            alignment: right
        }
        layout {
            sequence: 60
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: COUNTY
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_IS_VERIFIED (
        type: radioGroup
        label {
            label: Verified
            alignment: right
        }
        settings {
            noOfCols: 10
        }
        lov {
            type: sharedComponent
            lov: @lov-yes-no
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: IS_VERIFIED
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_KRA_PIN (
        type: textField
        label {
            label: KRA PIN
            alignment: right
        }
        layout {
            sequence: 110
            region: @buyer-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @buyer-form
            column: KRA_PIN
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_LATITUDE (
        type: numberField
        label {
            label: Latitude
            alignment: right
        }
        layout {
            sequence: 80
            region: @buyer-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: LATITUDE
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_LOCATION_NAME (
        type: textField
        label {
            label: Location
            alignment: right
        }
        layout {
            sequence: 70
            region: @buyer-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @buyer-form
            column: LOCATION_NAME
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    pageItem P11_LONGITUDE (
        type: numberField
        label {
            label: Longitude
            alignment: right
        }
        layout {
            sequence: 90
            region: @buyer-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @buyer-form
            column: LONGITUDE
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    
    
    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_BUYER_ID
        }
        
    )
    
    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        
        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )
    )
    
    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_BUYER_ID
        }
        
    )
    
    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_BUYER_ID
        }
        
    )
    
    
    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P11_BUYER_ID
        }
        execution {
            sequence: 20
        }
    )
    
    process initialize-form-buyer-form (
        name: Initialize form Buyer Form
        type: formInitialization
        formRegion: @buyer-form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    
    process process-form-buyer-form (
        name: Process form Buyer Form
        type: formAutoRowProcessing
        formRegion: @buyer-form
        execution {
            sequence: 10
        }
    )
    
    
)


page 30 (
    name: My Demands
    alias: MY-DEMANDS
    title: My demands
    pageGroup: @marketplace
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Canvas screen 3. The signed-in buyer's demands (every demand for operations) with fulfilment, from HL_FULFIL_V.
    }

    region stats (
        name: Your orders at a glance
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with d as (
                  select f.*
                    from HL_FULFIL_V f
                   where (hl_auth.buyer_id is null or f.BUYER_ID = hl_auth.buyer_id)
                )
                select 1 as SORT_ORDER, 'Active demands' as LABEL
                     , to_char(count(*), 'FM999G990') as METRIC
                     , 'Open, partly or fully sourced' as META
                  from d where d.STATUS in ('OPEN', 'PARTIAL', 'FILLED')
                union all
                select 2, 'Confirmed supply'
                     , to_char(nvl(sum(d.MATCHED_KG), 0), 'FM999G999G990') || ' kg'
                     , 'Farmers have said yes'
                  from d where d.STATUS in ('OPEN', 'PARTIAL', 'FILLED')
                union all
                select 3, 'Awaiting farmers'
                     , to_char(nvl(sum(d.PENDING_KG), 0), 'FM999G999G990') || ' kg'
                     , to_char(nvl(sum(d.PENDING_FARMERS), 0)) || ' farmers still to confirm'
                  from d where d.STATUS in ('OPEN', 'PARTIAL', 'FILLED')
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-top-md
                margin-bottom-md
            ]
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &LABEL.
            metric: &METRIC.
            metricCssClasses: u-text-subheading-md
            meta: &META.
            layout: stacked
        }

        column LABEL (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column META (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: META
                dataType: varchar2
            }
        )

        column METRIC (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: METRIC
                dataType: varchar2
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: SORT_ORDER
                dataType: number
                primaryKey: true
            }
        )

    )

    region demands (
        name: Demands
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.DEMAND_ID as DEMAND_ID
                     , 'HL-D-' || lpad(f.DEMAND_ID, 4, '0')
                       || case when hl_auth.buyer_id is null then ' · ' || f.BUYER_NAME end as OVERLINE
                     , case when f.TARGET_KG >= 1000
                            then to_char(f.TARGET_KG / 1000, 'FM999G990D0') || ' t'
                            else to_char(f.TARGET_KG, 'FM999G990') || ' kg' end
                       || ' of Grade ' || f.GRADE_REQUIRED || ' ' || f.CROP_NAME as TITLE
                     , 'Deliver ' || to_char(f.NEED_BY_DATE, 'Dy DD Mon') || ' · '
                       || case f.STATUS when 'DRAFT' then 'Draft'
                                        when 'OPEN' then 'Looking for farmers'
                                        when 'PARTIAL' then 'Partly sourced'
                                        when 'FILLED' then 'Fully sourced'
                                        when 'CLOSED' then 'Delivered'
                                        else initcap(f.STATUS) end as MISC
                     , '<div class="hl-fulfil hl-fulfil--compact">'
                       || '<div class="hl-fulfil__track" role="img" aria-label="'
                       || f.FILL_PCT || '% of the order sourced">'
                       || '<span class="hl-fulfil__seg hl-fulfil__seg--matched" style="width:'
                       || to_char(least(100 * f.MATCHED_KG / f.TARGET_KG, 100), 'FM990D0', 'NLS_NUMERIC_CHARACTERS=''.,''') || '%"></span>'
                       || '<span class="hl-fulfil__seg hl-fulfil__seg--pending" style="width:'
                       || to_char(least(100 * f.PENDING_KG / f.TARGET_KG, 100), 'FM990D0', 'NLS_NUMERIC_CHARACTERS=''.,''') || '%"></span>'
                       || '</div>'
                       || '<ul class="hl-fulfil__legend">'
                       || '<li><i class="hl-dot hl-dot--matched"></i>Confirmed <b>'
                       || to_char(f.MATCHED_KG, 'FM999G999G990') || ' kg</b></li>'
                       || '<li><i class="hl-dot hl-dot--pending"></i>Awaiting <b>'
                       || to_char(f.PENDING_KG, 'FM999G999G990') || ' kg</b></li>'
                       || '<li><i class="hl-dot hl-dot--open"></i>Open <b>'
                       || to_char(f.UNMATCHED_KG, 'FM999G999G990') || ' kg</b></li>'
                       || '</ul></div>' as BODY_HTML
                from HL_FULFIL_V f
                where (hl_auth.buyer_id is null or f.BUYER_ID = hl_auth.buyer_id)
                  and f.STATUS <> 'CANCELLED'
                order by case when f.STATUS = 'CLOSED' then 1 else 0 end, f.NEED_BY_DATE
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            description: &BODY_HTML!RAW.
            miscellaneous: &MISC.
        }

        column BODY_HTML (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BODY_HTML
                dataType: varchar2
            }
        )

        column DEMAND_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: DEMAND_ID
                dataType: number
                primaryKey: true
            }
        )

        column MISC (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MISC
                dataType: varchar2
            }
        )

        column OVERLINE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

        action open-matches (
            position: fullRowLink
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 32
                    items: {
                        P32_DEMAND_ID: \&DEMAND_ID.\
                    }
                }
            }
        )

    )

    button post-demand (
        buttonName: POST_DEMAND
        label: Post a demand
        layout {
            sequence: 10
            region: @demands
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 31
            }
        }
    )

)

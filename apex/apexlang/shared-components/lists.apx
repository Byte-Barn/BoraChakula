list navigation-bar (
    name: Navigation Bar
    
    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )
    
    entry app-user (
        label: &APP_USER.
        serverSideCondition {
            type: userIsAuthenticated
        }
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )
    
    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )
    
)

list navigation-menu (
    name: Navigation Menu
    
    entry my-farm (
        label: My farm
        icon {
            imageIconCssClasses: fa-leaf
        }
        layout {
            sequence: 1
        }
        link {
            target: {
                page: 20
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_farmer or hl_auth.is_ops
        }
    )

    entry my-demands (
        label: My demands
        icon {
            imageIconCssClasses: fa-shopping-basket
        }
        layout {
            sequence: 2
        }
        link {
            target: {
                page: 30
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_buyer or hl_auth.is_ops
        }
    )

    entry post-a-demand (
        label: Post a demand
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 3
        }
        link {
            target: {
                page: 31
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_buyer or hl_auth.is_ops
        }
    )

    entry matches (
        label: Matches
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 4
        }
        link {
            target: {
                page: 32
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_buyer or hl_auth.is_ops
        }
    )

    entry logistics (
        label: Logistics
        icon {
            imageIconCssClasses: fa-truck
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 41
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_buyer or hl_auth.is_ops
        }
    )

    entry route-by-grade (
        label: Route by grade
        icon {
            imageIconCssClasses: fa-random
        }
        layout {
            sequence: 6
        }
        link {
            target: {
                page: 40
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: hl_auth.is_ops
        }
    )

    entry impact (
        label: Impact
        icon {
            imageIconCssClasses: fa-globe
        }
        layout {
            sequence: 7
        }
        link {
            target: {
                page: 42
            }
        }
    )

    
    entry agreement-ledger (
        label: Agreement Ledger
        icon {
            imageIconCssClasses: fa-link
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 13
            }
        }
    )
    
    entry buyer-demands (
        label: Buyer Demands
        icon {
            imageIconCssClasses: fa-shopping-cart
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )
    
    entry buyers (
        label: Buyers
        icon {
            imageIconCssClasses: fa-building
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 10
            }
        }
    )
    
    entry farmer-harvests (
        label: Farmer Harvests
        icon {
            imageIconCssClasses: fa-leaf
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 4
            }
        }
    )
    
    entry farmers (
        label: Farmers
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 70
        }
        link {
            target: {

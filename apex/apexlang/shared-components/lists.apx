            }
        }
    )
    
    entry impact-dashboard (
        label: Impact Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )
    
    entry match-planner (
        label: Match Planner
        icon {
            imageIconCssClasses: fa-map
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 6
            }
        }
    )
    
)


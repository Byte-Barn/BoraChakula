plugin hlAlert (
    name: HL Alert
    staticId: COM.HARVESTLINK.ALERT
    templateComponent {
        availableAs: [
            partial
        ]
        partial:
            ```html
            <div class="hl-alert hl-alert-#TONE!ATTR#" role="status">{case TONE/}{when success/}<svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM5.25 8.25l2 2 3.5-4"></path></svg>{when warning/}<svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 2L1.75 13.25h12.5zM8 6.5v3M8 11.25v.25"></path></svg>{when error/}<svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 2L1.75 13.25h12.5zM8 6.5v3M8 11.25v.25"></path></svg>{otherwise/}<svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5A6.25 6.25 0 0 0 8 1.75zM8 7.25v4M8 4.75v.25"></path></svg>{endcase/}<div>{if ?TITLE/}<b>#TITLE#</b>{endif/}#BODY#{if ?LINK_URL/} <a class="hl-link" href="#LINK_URL!ATTR#">#LINK_LABEL#</a>{endif/}</div></div>
            ```
        translateTemplates: false
    }
    component {
        standardAttributes: regionTemplateAttr
    }
    information {
        helpText: Page or form message for info, success, warning and error (HarvestLink design system Alert).
    }
)

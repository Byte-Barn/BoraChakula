plugin hlPageHeader (
    name: HL Page Header
    staticId: COM.HARVESTLINK.PAGEHEADER
    templateComponent {
        availableAs: [
            partial
        ]
        partial:
            ```html
            <header class="hl-ph">{if ?BACK_URL/}<a class="hl-ph-back hl-link" href="#BACK_URL!ATTR#" style="text-decoration:none"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 8H3M7 4L3 8l4 4"></path></svg>#BACK_LABEL#</a>{endif/}{if ?EYEBROW/}<span class="hl-overline">#EYEBROW#</span>{endif/}<div class="hl-ph-row"><div class="hl-stack" style="gap:4px"><h1>#TITLE#</h1>{if ?DESCRIPTION/}<p>#DESCRIPTION#</p>{endif/}</div></div></header>
            ```
        translateTemplates: false
    }
    component {
        standardAttributes: regionTemplateAttr
    }
    information {
        helpText: Top of an app page: back link, eyebrow, the page's h1 and a description (HarvestLink design system PageHeader).
    }
)

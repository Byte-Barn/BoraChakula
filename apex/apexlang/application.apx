app HARVESTLINK (
    name: HarvestLink
    logo {
        type: text
        text: HarvestLink
    }
    navigation {
        homeUrl: {
            page: 50
        }
        loginUrl: {
            page: 9000
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
    }
    errorHandling {
        defaultDisplayLocation: inlineInNotification
        errorHandlingFunctionName: hl_apex_error.handle
    }
    authentication {
        scheme: @harvestlink-accounts
    }
    
    substitution APP_NAME (
        value {
            staticValue: HarvestLink
        }
    )
    
)

